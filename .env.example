NEXT_PUBLIC_STORE_NAME=ÉLARA
NEXT_PUBLIC_SITE_URL=https://elara-olive.vercel.app
APP_URL=https://elara-olive.vercel.app

# Supabase Postgres: copy the shared pooler connection string from Dashboard > Connect.
# For Vercel use shared pooler transaction mode (port 6543), not the direct IPv6 hostname.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require

# Server-side Supabase credentials. NEVER use NEXT_PUBLIC_ for secret keys.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
# Legacy service_role key is also supported as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_STORAGE_BUCKET=elara-product-images
# Public URL prefix; append the uploaded object path after this value.
PUBLIC_MEDIA_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/elara-product-images

# Generate ADMIN_PASSWORD_HASH with scripts/hash-password.mjs.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Keep Mercado Pago in test mode until the entire webhook flow is verified.
MP_MODE=test
MP_ACCESS_TOKEN_TEST=
MP_ACCESS_TOKEN_PROD=
MP_WEBHOOK_SECRET=

# Shipping in centimos PEN. Do not enable checkout until this has a real value.
SHIPPING_FLAT_CENTS=
