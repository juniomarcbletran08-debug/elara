NEXT_PUBLIC_STORE_NAME=ÉLARA
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Public HTTPS base URL for the R2 bucket or custom media domain
PUBLIC_MEDIA_URL=

# Set secrets with Wrangler, never commit real credentials.
# Generate an admin hash with scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Mercado Pago must remain in test mode until the webhook is verified.
MP_MODE=test
MP_ACCESS_TOKEN_TEST=
MP_ACCESS_TOKEN_PROD=
MP_WEBHOOK_SECRET=

# Shipping amount in centimos PEN. Do not enable checkout until defined.
SHIPPING_FLAT_CENTS=
